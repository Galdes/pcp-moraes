# Banco PostgreSQL (local via docker compose, ou Supabase/Neon/RDS em produção)
DATABASE_URL=postgres://pcp:pcp@localhost:5432/pcp

# Segredo para chamadas agendadas (sincronização Omie)
CRON_SECRET=troque-por-um-valor-longo-e-aleatorio
# Chave (16+ caracteres) que criptografa as credenciais do Omie salvas na tela Integrações.
# ATENÇÃO: se hoje as credenciais foram salvas usando EXPORT_TOKEN, copie o MESMO valor para CHAVE_CONFIG antes de remover EXPORT_TOKEN.
CHAVE_CONFIG=troque-por-outro-valor-longo

# Integração Omie (deixe OMIE_MODO=desligado até validar em homologação)
# desligado | simulacao (registra o payload sem enviar) | ativo
OMIE_MODO=desligado
OMIE_APP_KEY=
OMIE_APP_SECRET=
# Limite por método por minuto. Plano padrão: 240 (usamos 200 de folga). Plano Fit: 60 req/min e 500/dia.
OMIE_REQ_POR_MINUTO=200
OMIE_LIMITE_DIARIO=0
# Código do local de estoque do Omie considerado disponível para produção (vazio = todos)
OMIE_LOCAL_ESTOQUE=

# Fuso horário da fábrica
TZ=America/Sao_Paulo

# Token para a TV do chão de fábrica abrir /tv?token=... sem login (só leitura daquela tela)
TV_TOKEN=
# Endereço público usado no QR da ficha (ex.: https://pcp.moraes.com.br). Vazio = o endereço acessado.
URL_PUBLICA=
# Hora de início do turno (para converter a programação em horário)
INICIO_TURNO_HORA=7
# Métodos de escrita do Omie validados no portal (liberam o envio). Ex.: ConcluirOrdemProducao,IncluirReq
OMIE_CONTRATOS_VALIDADOS=
# Etapas de pedido de venda no Omie consideradas faturadas/atendidas
OMIE_ETAPAS_FATURADO=60,70,80
# Só para testes locais em http (sem https): permite o cookie de sessão sem "Secure"
COOKIE_INSEGURO=
